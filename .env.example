# ---------------------------------------------------------------------------
# MyPadi environment. Copy to `.env` and fill in. NEVER commit .env.
# No secret values belong in this example file.
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
PORT=3100                       # Phase 1 uses 3100+ (CeloDesk owns 3000/3001)
PUBLIC_BASE_URL=http://localhost:3100   # public URL once deployed; serves agent-registration.json

# --- Identity (constants live in src/config/identity.ts; wallet comes from here) ---
# The MyPadi agent wallet address. Filled by scripts/wallet-new.ts in Phase 1.
AGENT_WALLET=
# Private key for the MyPadi wallet. Generated locally by wallet-new.ts. NEVER commit. NEVER log.
# Only used to (a) assert the derived address matches AGENT_WALLET and (b) sign the ERC-8004 tx.
AGENT_PRIVATE_KEY=

# --- Telegram (own bot from @BotFather, NOT CeloDesk's @celoagentbot) ---
TELEGRAM_BOT_TOKEN=

# --- Groq (primary LLM: openai/gpt-oss-120b) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mypadi

# --- buy CLI adapter ---
# Phase 1: sandbox only. Set to 'sandbox' to force --sandbox on every call.
BUY_MODE=sandbox
BUY_TOKEN=USDC                   # USDC|USDT|USAT (sandbox supports USDC only)
BUY_ACCOUNT=mypadi               # buy keystore account name (from `buy setup --name`)
BUY_BIN=buy
# Keystore backend. Leave UNSET on local Windows: buy's file backend requires a POSIX 0600
# key file, which Windows cannot represent (Node reports 0666), so signing fails with
# "could not read key". On Windows the default OS keychain (Credential Manager) works.
# On the Linux VPS deploy, SET this to `file` (0600 is real there) for a headless keystore.
BUY_KEYSTORE_BACKEND=file
BUY_HOME=./buy-home
# Daily spend cap (USD) enforced via `buy account cap`. Also mirrored in our ledger.
BUY_DAILY_CAP_USD=1.00
# Import key for `buy setup --import` (env, NEVER passed as an argument). Phase 2.
BUY_IMPORT_KEY=

# --- Budget ledger (USD) ---
BUDGET_GLOBAL_USD=5.00
BUDGET_PER_TASK_USD=0.50
BUDGET_PER_USER_USD=1.00
BUDGET_FAILURE_RESERVE_USD=0.50

# --- Chain (reads only in Phase 1) ---
CELO_RPC_URL=https://forno.celo.org
